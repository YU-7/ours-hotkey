{
  "Windows": {
    "Maximum": {
      "Oringin": "win + ",
      "Remap": "CapsLock + B"
    },
    "Minimum": {
      "Oringin": "win + ",
      "Remap": "CapsLock + Q"
    },
    "CloseWindow": {
      "Oringin": "win + ",
      "Remap": "CapsLock + X"
    },
    "SwitchWindow": {
      "Oringin": "win + ",
      "Remap": "CapsLock + V"
    }
  },
  "VurtualDesktop": {
    "GoPrevious": {
      "Oringin": "ctrl + win + UP",
      "Remap": "CapsLock + Y"
    },
    "GoNext": {
      "Oringin": "ctrl + win + DOWN",
      "Remap": "CapsLock + P"
    }
  },
  "TaskManger": {
    "Open": {
      "Oringin": "alt + tab + ctrl",
      "Remap": "CapsLock + E"
    },
    "Direction": {
      "Up": "E",
      "Down": "D",
      "Left": "S",
      "Right": "F",
      "Close": "C",
      "Enter": "Enter"
    }
  },
  "CopyFilePath": {
    "Oringin": "ctrl + c",
    "Remap": "CapsLock + Z"
  }
}
